# Nexora Dot X configuration
NEXORA_HOST=127.0.0.1
NEXORA_PORT=8000
NEXORA_DATA_DIR=./data
NEXORA_MODEL_DIR=./models
NEXORA_LOCAL_ONLY=true
NEXORA_AUTH_ENABLED=false
NEXORA_LOG_LEVEL=INFO
# Optional remote provider (only used when NEXORA_LOCAL_ONLY=false)
# NEXORA_OPENAI_BASE_URL=
# NEXORA_OPENAI_API_KEY=
# NEXORA_SECRET_GITHUB_TOKEN=
